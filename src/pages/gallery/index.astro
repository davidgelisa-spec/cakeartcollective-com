---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/ui/GalleryGrid.astro';
import Lightbox from '../../components/ui/Lightbox.astro';

// Sculpted — fantasy & artistic (sculpted-cakes/ root)
import elephantSunset from '../../assets/images_cakeartcollective/Featured on front page/sculpted-elephant-african-sunset-cake-cropped.jpg';
import elephantPrint from '../../assets/images_cakeartcollective/sculpted-cakes/sculpted-elephant-cake-african-print.jpg';
import cheshireCat from '../../assets/images_cakeartcollective/sculpted-cakes/sculpted-cheshire-cat-cake-green-eyes.jpg';
import tRex from '../../assets/images_cakeartcollective/sculpted-cakes/sculpted-t-rex-dinosaur-cake-rainbow-tail.jpeg';
import tRexHead from '../../assets/images_cakeartcollective/sculpted-cakes/sculpted-t-rex-head-detail-teeth.jpeg';
import carnivorous from '../../assets/images_cakeartcollective/sculpted-cakes/sculpted-carnivorous-plant-cake-competition.jpeg';
import crown from '../../assets/images_cakeartcollective/sculpted-cakes/sculpted-royal-crown-cake-purple-gold.jpg';
import henSide from '../../assets/images_cakeartcollective/sculpted-cakes/sculpted-hen-cake-side-profile.jpeg';
import watercolourWatch from '../../assets/images_cakeartcollective/sculpted-cakes/blue-gold-watercolour-cake-watch-topper.jpeg';

// Celebration & Floral Cakes
import cherryBlossom from '../../assets/images_cakeartcollective/celebration-cakes/cherry-blossom-tree-buttercream-cake.jpeg';
import buttercreamFlowers from '../../assets/images_cakeartcollective/celebration-cakes/buttercream-flower-cake-pink-peony-clematis.jpg';
import flowerCupcakes from '../../assets/images_cakeartcollective/celebration-cakes/buttercream-flower-cupcakes-roses-hydrangeas.jpeg';
import hpPink from '../../assets/images_cakeartcollective/celebration-cakes/harry-potter-pink-cake-golden-snitch.jpg';
import hpPinkFull from '../../assets/images_cakeartcollective/celebration-cakes/harry-potter-pink-cake-full-view.jpeg';
import firstBirthday from '../../assets/images_cakeartcollective/celebration-cakes/first-birthday-cake-pink-peony-rose-gold.jpeg';
import elegantRoses from '../../assets/images_cakeartcollective/celebration-cakes/elegant-buttercream-cake-white-roses.jpg';
import beach40th from '../../assets/images_cakeartcollective/celebration-cakes/beach-themed-40th-birthday-cake.jpeg';
import retro80s from '../../assets/images_cakeartcollective/celebration-cakes/retro-80s-birthday-cake-boombox.jpeg';
import monstera from '../../assets/images_cakeartcollective/celebration-cakes/tropical-monstera-birthday-cake-detail.jpeg';
import minion from '../../assets/images_cakeartcollective/celebration-cakes/minion-sculpted-cake-cupcakes.png';
import christeningElephant from '../../assets/images_cakeartcollective/celebration-cakes/christening-cake-blue-pink-elephant-topper.jpg';
import christeningBunting from '../../assets/images_cakeartcollective/celebration-cakes/christening-cake-bunting-alphabet-blocks.jpg';
import fortnite from '../../assets/images_cakeartcollective/celebration-cakes/sculpted-fortnite-llama-cake-purple.jpeg';
import hpBooks from '../../assets/images_cakeartcollective/celebration-cakes/sculpted-harry-potter-books-sorting-hat.jpg';
import sherwani from '../../assets/images_cakeartcollective/celebration-cakes/sculpted-green-sherwani-mendhi-cake.jpeg';
import sherwaniMendhi from '../../assets/images_cakeartcollective/celebration-cakes/mendhi-celebration-sherwani-cake.jpeg';
import lemonTiles from '../../assets/images_cakeartcollective/celebration-cakes/lemon-blue-tile-two-tier-cake-garden-cropped.jpg';
import hamilton from '../../assets/images_cakeartcollective/celebration-cakes/hamilton-cake-yellow-star-silhouettes.jpeg';
import hamiltonDetail from '../../assets/images_cakeartcollective/celebration-cakes/hamilton-cake-jacket-star-detail.jpeg';

// Hyper-realistic — "Yes, it's really cake" (sculpted-cakes/Hyper-realistic /)
import rolexBox from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-rolex-box-cake-front-white.jpeg';
import rolexWatch from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-rolex-daytona-watch-closeup.jpeg';
import rolexAngle from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-rolex-box-cake-angle-two.jpeg';
import rolexMarble from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-rolex-watch-box-cake-marble-base.jpeg';
import rolexDaytonaAngle from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-rolex-daytona-watch-box-closeup-angle.jpeg';
import rolexTopDown from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-rolex-box-cake-top-down.png';
import hen from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-hen-cake-feather-detail-rear.jpg';
import henFront from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-hen-cake-front-view-chickens.jpg';
import eggCarton from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-egg-carton-cake-speckled-eggs.jpg';
import treeStump from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-tree-stump-axe-cake-full.jpeg';
import treeStumpBark from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-tree-stump-cake-bark-detail.jpg';
import rainbowWatch from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-gold-rainbow-watch-green-box.jpg';
import koiFish from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-koi-fish-cake-front-view.jpeg';
import koiFishScales from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-koi-fish-cake-closeup-scales.jpeg';
import koiFishSide from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-koi-fish-cake-side-view.jpeg';
import chicken from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /Chicken sculpted cake.jpeg';
import trout from '../../assets/images_cakeartcollective/sculpted-cakes/Hyper-realistic /sculpted-rainbow-trout-wooden-plaque-fishing-line.jpeg';

// Sculpted — cleanest photographs first; darker or watermarked shots last
const sculptedWork = [
  { src: elephantSunset, title: 'Elephant sunset cake', alt: 'Gold sculpted elephant emerging from a hand-painted African sunset scene in blue, magenta, and yellow' },
  { src: tRex, title: 'Sculpted T-Rex cake', alt: 'Full-body sculpted T-Rex dinosaur in green with a rainbow-striped tail on a stone-textured base' },
  { src: crown, title: 'Royal crown cake', alt: 'Sculpted royal crown in purple velvet and burnished gold with jewel details and ermine-style base' },
  { src: watercolourWatch, title: 'Watercolour cake with watch', alt: 'Blue and gold watercolour-painted cake topped with a sculpted black chronograph watch in a blue box' },
  { src: fortnite, title: 'Loot llama cake', alt: 'Sculpted Fortnite Loot Llama pinata cake in purple, blue and pink standing upright on a marbled base' },
  { src: elephantPrint, title: 'Elephant breakthrough cake', alt: 'Sculpted elephant cake with colourful African print pattern and detailed trunk and tusks' },
  { src: carnivorous, title: 'Carnivorous plant cake', alt: 'Sculpted carnivorous plant cake with realistic tendrils, created for a cake competition' },
  { src: tRexHead, title: 'T-Rex head detail', alt: 'Close-up of sculpted T-Rex head showing detailed open mouth with teeth and vivid yellow eye' },
  { src: cheshireCat, title: 'Cheshire Cat cake', alt: 'Sculpted Cheshire Cat with glowing green eyes and wide toothy grin against a dark forest backdrop' },
  { src: henSide, title: 'Sculpted hen cake', alt: 'Sculpted white hen cake side profile showing detailed feather textures' },
];

// Celebration & floral — whole cakes first
const celebrationWork = [
  { src: cherryBlossom, title: 'Cherry blossom tree cake', alt: 'Two-tier white buttercream cake with a sculpted cherry blossom tree and dozens of handcrafted pink flowers' },
  { src: buttercreamFlowers, title: 'Mint buttercream flower cake', alt: 'Two-tier mint buttercream cake with elaborate piped pink peony, roses, purple clematis and lush green leaves' },
  { src: lemonTiles, title: 'Lemon and blue tile cake', alt: 'Two-tier pale yellow cake wrapped in blue and yellow painted-tile panels, decorated with sugar lemons and leaves, on a white cake stand' },
  { src: firstBirthday, title: 'First birthday peony cake', alt: 'Elegant first birthday cake with smooth cream buttercream, rose gold base, and a large pink sugar peony' },
  { src: flowerCupcakes, title: 'Buttercream flower cupcakes', alt: 'Overhead arrangement of buttercream flower cupcakes with piped roses, ranunculus and hydrangeas in pink, burgundy and cream' },
  { src: elegantRoses, title: 'Ivory buttercream rose cake', alt: 'Single-tier cake with textured ivory buttercream swirls topped with white and pale pink sugar roses and baby\'s breath' },
  { src: hpPink, title: 'Pink Harry Potter cake', alt: 'Pink Harry Potter birthday cake with gold fondant Golden Snitch, Hogwarts crest, white quill and gold stars' },
  { src: hpBooks, title: 'Harry Potter books cake', alt: 'Sculpted Harry Potter book stack with History of Magic, Quidditch, brown Sorting Hat and Gryffindor scarf detail' },
  { src: retro80s, title: 'Retro 80s birthday cake', alt: 'Retro 80s birthday cake shaped like a boombox with vibrant neon colours and cassette details' },
  { src: hamilton, title: 'Hamilton cake', alt: 'Hamilton-themed cake with a textured yellow base tier showing a black star and silhouette figures, topped by a sculpted ivory jacket tier with gold buttons and a ruffled collar' },
  { src: beach40th, title: 'Beach 40th birthday cake', alt: 'Beach-themed 40th birthday cake with sand-textured frosting, seashells, and tropical details' },
  { src: monstera, title: 'Tropical monstera cake', alt: 'Tropical birthday cake with hand-painted monstera leaves and botanical details' },
  { src: sherwani, title: 'Sherwani cake', alt: 'Sculpted green sherwani cake with ornate embossed fabric texture, metallic buttons and decorative brooch' },
  { src: sherwaniMendhi, title: 'Mendhi sherwani cake', alt: 'Sculpted mendhi celebration cake with ornate sherwani design and intricate patterns' },
  { src: christeningElephant, title: 'Christening cake', alt: 'Christening cake with blue and pink elephant topper and delicate details' },
  { src: christeningBunting, title: 'Christening cake detail', alt: 'Christening cake with bunting decoration and alphabet blocks' },
  { src: hamiltonDetail, title: 'Hamilton cake detail', alt: 'Close-up of the Hamilton cake showing the black star silhouette, the ivory jacket tier with gold buttons, and a sugar letter and quill' },
  { src: minion, title: 'Minion cake and cupcakes', alt: 'Sculpted Minion cake with matching decorated cupcakes' },
  { src: hpPinkFull, title: 'Pink Harry Potter cake, full view', alt: 'Full view of pink Harry Potter birthday cake showing all tiers and decoration details' },
];

// Yes, it's really cake — whole cakes first, close-ups and repeat angles after
const hyperReal = [
  { src: rolexMarble, title: 'Rolex box cake', alt: 'Sculpted Rolex watch box cake on a marble base with green case and cushioned watch' },
  { src: koiFish, title: 'Koi fish cake', alt: 'Sculpted koi fish in orange, white and black leaping over a turquoise water base with wave details' },
  { src: treeStump, title: 'Tree stump and axe cake', alt: 'Realistic tree stump cake with detailed bark texture, silver axe embedded in top, and moss at the base' },
  { src: trout, title: 'Rainbow trout cake', alt: 'Sculpted rainbow trout cake mounted on a wooden plaque with fishing line detail' },
  { src: eggCarton, title: 'Egg carton cake', alt: 'Sculpted egg carton cake with six realistic speckled brown eggs on straw and a birthday message card' },
  { src: rainbowWatch, title: 'Rainbow watch cake', alt: 'Sculpted gold luxury watch with rainbow-coloured bezel resting on a white cushion inside a green presentation box' },
  { src: chicken, title: 'Sculpted hen cake', alt: 'Sculpted chicken cake with detailed feather textures and realistic colouring' },
  { src: rolexWatch, title: 'Rolex watch detail', alt: 'Close-up of sculpted silver Rolex Daytona watch with warranty card and wax seal on white cushion' },
  { src: koiFishSide, title: 'Koi fish cake, side view', alt: 'Sculpted koi fish cake side view showing the full leaping pose over a water base' },
  { src: koiFishScales, title: 'Koi scales detail', alt: 'Close-up of sculpted koi fish cake showing detailed hand-painted orange and white scales' },
  { src: treeStumpBark, title: 'Tree stump bark detail', alt: 'Close-up of sculpted tree stump cake showing detailed bark texture and moss' },
  { src: rolexDaytonaAngle, title: 'Rolex watch close-up', alt: 'Close-up angle of sculpted Rolex Daytona watch and box showing face detail' },
  { src: henFront, title: 'Hen cake, front view', alt: 'Sculpted white hen cake from the front with real chickens in the background' },
  { src: hen, title: 'Hen cake feather detail', alt: 'Sculpted white hen cake with incredibly detailed grey-tipped feather textures, real chickens visible in the background' },
  { src: rolexBox, title: 'Rolex box cake, front view', alt: 'Sculpted Rolex Daytona watch box with open green case, silver watch on white cushion and branding detail' },
  { src: rolexAngle, title: 'Rolex box cake, second angle', alt: 'Sculpted Rolex watch box cake from a second angle showing green case and silver watch detail' },
  { src: rolexTopDown, title: 'Rolex box cake from above', alt: 'Top-down view of sculpted Rolex watch box cake showing watch face and green case detail' },
];
---

<BaseLayout
  title="Gallery"
  description="Custom cakes by Cake Art Collective. Sculpted cakes, celebration cakes, and wedding cakes by Lisa."
>
  <!-- Page header -->
  <section class="max-w-7xl mx-auto px-6 page-header">
    <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">Gallery</h1>
    <p class="text-text-secondary text-lg max-w-xl">
      Sculpted, painted, and built by hand.
    </p>
    <nav aria-label="Gallery categories" class="flex flex-wrap gap-x-6 gap-y-2 mt-5">
      {[
        { label: 'Sculpted', href: '#sculpted' },
        { label: 'Celebration & floral', href: '#celebration' },
        { label: "Yes, it's really cake", href: '#hyper-realistic' },
        { label: 'Weddings', href: '/gallery/weddings/' },
      ].map((link) => (
        <a href={link.href} class="link-quiet">{link.label}</a>
      ))}
    </nav>
  </section>

  <section id="sculpted" class="max-w-7xl mx-auto px-6 pt-2 md:pt-10 pb-12 md:pb-16 scroll-mt-24">
    <h2 class="font-heading text-3xl md:text-4xl text-text mb-2 md:mb-3">Sculpted</h2>
    <p class="text-text-secondary md:text-lg max-w-xl mb-6 md:mb-10">
      Carved, modelled, and painted.
    </p>
    <GalleryGrid items={sculptedWork} />
  </section>

  <section id="celebration" class="max-w-7xl mx-auto px-6 py-12 md:py-16 border-t border-border scroll-mt-24">
    <h2 class="font-heading text-3xl md:text-4xl text-text mb-2 md:mb-3">Celebration &amp; floral</h2>
    <p class="text-text-secondary md:text-lg max-w-xl mb-6 md:mb-10">
      Buttercream flowers and painted finishes for birthdays and special occasions.
    </p>
    <GalleryGrid items={celebrationWork} />
  </section>

  <section id="hyper-realistic" class="max-w-7xl mx-auto px-6 py-12 md:py-16 border-t border-border scroll-mt-24">
    <h2 class="font-heading text-3xl md:text-4xl text-text mb-2 md:mb-3">Yes, it's really cake</h2>
    <p class="text-text-secondary md:text-lg max-w-xl mb-6 md:mb-10">
      Designed to fool the eye. Every detail is edible.
    </p>
    <GalleryGrid items={hyperReal} />
  </section>

  <!-- Wedding link -->
  <section class="max-w-7xl mx-auto px-6 pb-16 md:pb-24">
    <a href="/gallery/weddings/" class="link-quiet">View wedding cakes &rarr;</a>
  </section>

  <!-- CTA -->
  <section class="section-deep">
    <div class="max-w-7xl mx-auto px-6 section text-center">
      <h2 class="font-heading text-3xl md:text-4xl text-secondary-light mb-4">
        Have something in mind?
      </h2>
      <p class="text-on-deep text-lg max-w-xl mx-auto mb-8">
        Every cake is designed from scratch. Tell me about your occasion and I'll create something you'll love.
      </p>
      <a href="/contact/?type=cake" class="btn btn-on-deep">
        Get in touch
      </a>
    </div>
  </section>

  <Lightbox />
</BaseLayout>
