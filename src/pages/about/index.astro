---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

import portrait from '../../assets/images_cakeartcollective/about/lisa-davidge-with-five-tier-wedding-cake.jpg';
---

<BaseLayout
  title="About"
  description="About Lisa — the person behind Cake Art Collective. Custom cakes and decorating classes."
>
  <!-- Page header -->
  <section class="max-w-7xl mx-auto px-6 page-header">
    <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">About</h1>
    <p class="text-text-secondary text-lg max-w-xl">
      The person behind the cakes.
    </p>
  </section>

  <!-- Story -->
  <section class="max-w-7xl mx-auto px-6 pt-4 md:pt-6 pb-16 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-10 lg:gap-20 items-start">
      <!-- Portrait comes first on phones, sits to the right on desktop -->
      <figure class="lg:order-2 max-w-md">
        <Image
          src={portrait}
          alt="Lisa Davidge smiling beside her five-tier white and gold wedding cake decorated with red roses"
          widths={[400, 600, 900, 1200]}
          sizes="(max-width: 1024px) 100vw, 450px"
          class="w-full h-auto block"
          loading="eager"
        />
      </figure>
    <div class="max-w-2xl">
      <p class="text-text-secondary text-lg mb-5">
        I'm Lisa, and I've been making cakes for over a decade. What started as curiosity turned into a career — designing, sculpting, and finishing every cake by hand.
      </p>
      <p class="text-text-secondary text-lg mb-5">
        Every cake I make is designed from scratch. I work closely with each customer to understand what they're after, whether that's an elegant tiered wedding cake, a sculpted birthday cake, or something completely unexpected. No two are ever the same.
      </p>
      <p class="text-text-secondary text-lg">
        I'm also passionate about teaching. My classes are for anyone who wants to learn — complete beginners, keen home bakers, or people looking for a creative experience. I keep groups small so everyone gets proper attention.
      </p>
    </div>
    </div>
  </section>


  <!-- How I Work — deep teal block -->
  <section class="section-deep">
    <div class="max-w-7xl mx-auto px-6 section">
      <div class="max-w-2xl">
        <h2 class="font-heading text-3xl md:text-4xl text-secondary-light mb-4">How I work</h2>
        <p class="text-on-deep text-lg mb-5">
          The best cakes come from really listening. I want to know about your occasion, the people, the details that matter to you. That's where the design starts.
        </p>
        <p class="text-on-deep text-lg mb-8">
          I care about quality in everything: the ingredients, the finish, the flavour. A cake should taste as good as it looks.
        </p>

        <div class="flex flex-wrap items-center gap-x-8 gap-y-5">
          <a href="/contact/" class="btn btn-on-deep">
            Get in touch
          </a>
          <a href="/gallery/" class="link-quiet">
            View gallery
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
