---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/siteConfig';

// Session is attached by middleware for /members/ routes
const session = (Astro.locals as any).session;
const memberName = session?.name ?? '';
const firstName = memberName.split(' ')[0];
---

<BaseLayout title="Members Area" description="Your Cake Art Collective courses and resources.">
  <section class="max-w-5xl mx-auto px-6 py-12 md:py-16">
    <div class="flex items-start justify-between gap-6 mb-10">
      <div>
        <h1 class="font-heading text-3xl md:text-4xl text-text">
          {firstName ? `Welcome, ${firstName}` : 'Welcome'}
        </h1>
      </div>
      <form method="POST" action="/api/auth/logout/">
        <button
          type="submit"
          class="link-quiet cursor-pointer"
        >
          Sign out
        </button>
      </form>
    </div>

    <div class="max-w-2xl pt-10 border-t border-border">
      <h2 class="font-heading text-2xl text-text mb-4">Your courses</h2>
      <p class="text-text-secondary mb-4">
        There's nothing here yet. Downloadable courses and resources will appear here once they launch.
      </p>
      <p class="text-text-secondary">
        Questions in the meantime? Email
        <a href={`mailto:${siteConfig.email}`} class="text-text underline hover:text-primary">{siteConfig.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
