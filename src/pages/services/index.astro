---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Services"
  description="Custom cakes and cake decorating classes by Cake Art Collective."
>
  <!-- Page header -->
  <section class="max-w-7xl mx-auto px-6 page-header">
    <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">Services</h1>
    <p class="text-text-secondary text-lg max-w-xl">
      Custom cakes and hands-on decorating classes.
    </p>
  </section>

  <!-- Services -->
  <section class="max-w-7xl mx-auto px-6 pt-4 md:pt-6 pb-16 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
      <!-- Custom Cakes -->
      <div>
        <h2 class="font-heading text-3xl md:text-4xl text-text mb-4">Custom cakes</h2>
        <p class="text-text-secondary text-lg mb-8">
          Every cake is designed around you and your occasion. Whether you know exactly what you want or need some inspiration, we'll work together to create something you'll love.
        </p>
        <div class="space-y-6 mb-10">
          <div>
            <h3 class="text-lg text-text mb-1">Process</h3>
            <p class="text-text-secondary">
              We start with a conversation about your event, your ideas and your tastes. I'll design your cake, arrange a tasting if you'd like, and take care of everything from there.
            </p>
          </div>
          <div>
            <h3 class="text-lg text-text mb-1">What I make</h3>
            <p class="text-text-secondary">
              Wedding cakes, birthday cakes, sculpted cakes — from classic and elegant to something completely unique. If you can imagine it, I can probably make it.
            </p>
          </div>
          <div>
            <h3 class="text-lg text-text mb-1">Pricing</h3>
            <p class="text-text-secondary">
              Every cake is quoted individually based on size, design and detail. Prices start from £150.
            </p>
          </div>
        </div>
        <a href="/contact/?type=cake" class="btn">
          Enquire about a cake
        </a>
      </div>

      <!-- Classes -->
      <div id="classes" class="scroll-mt-28">
        <h2 class="font-heading text-3xl md:text-4xl text-text mb-4">Classes</h2>
        <p class="text-text-secondary text-lg mb-8">
          Relaxed, hands-on classes for anyone who wants to learn. No experience needed — just enthusiasm. You'll leave with new skills and something you've made yourself.
        </p>
        <div class="space-y-6 mb-10">
          <div>
            <h3 class="text-lg text-text mb-1">In-person</h3>
            <p class="text-text-secondary">
              Small groups (max 6) in my studio. Hands-on from start to finish, with all materials provided. 1-to-1 sessions also available from £45 per hour.
            </p>
          </div>
          <div>
            <h3 class="text-lg text-text mb-1">Online</h3>
            <p class="text-text-secondary">
              Live sessions via video — learn from home with real-time guidance.
            </p>
          </div>
          <div>
            <h3 class="text-lg text-text mb-1">What you'll learn</h3>
            <p class="text-text-secondary">
              Buttercream techniques, sugar flowers, sculpted designs, colour mixing and more.
            </p>
          </div>
        </div>
        <a href="/contact/?type=classes" class="btn">
          Enquire about classes
        </a>
      </div>
    </div>
  </section>


  <!-- Tutorials mention — deep teal -->
  <section class="section-deep">
    <div class="max-w-7xl mx-auto px-6 section">
      <div class="max-w-2xl">
        <h2 class="font-heading text-3xl md:text-4xl text-secondary-light mb-4">Tutorials</h2>
        <p class="text-on-deep text-lg mb-8">
          Self-paced video tutorials are coming soon. Step-by-step lessons you can follow at home.
        </p>
        <a href="/tutorials/" class="link-quiet">
          Learn more &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
