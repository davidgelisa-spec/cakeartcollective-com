---
/**
 * Enlarged image viewer for gallery pages.
 * Opens when any <button data-lightbox-item> containing an <img> is clicked,
 * shows the largest available srcset candidate with the item's short title
 * (data-title) as a caption — the full description stays as the image alt text —
 * and offers an enquiry link that carries the design into the contact form.
 * Arrow keys / buttons step through every item on the page; Esc closes.
 */
---

<dialog id="lightbox" class="lightbox" aria-label="Enlarged cake photo">
  <div class="lightbox-inner">
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close">&times;</button>
    <button type="button" class="lightbox-nav lightbox-prev" data-lightbox-prev aria-label="Previous photo">&lsaquo;</button>
    <figure class="lightbox-figure">
      <img id="lightbox-img" alt="" />
      <figcaption>
        <p id="lightbox-caption" class="lightbox-caption"></p>
        <a id="lightbox-enquire" href="/contact/?type=cake" class="btn btn-on-deep">Enquire about a cake like this</a>
      </figcaption>
    </figure>
    <button type="button" class="lightbox-nav lightbox-next" data-lightbox-next aria-label="Next photo">&rsaquo;</button>
  </div>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-deep);
    color: var(--color-bg);
  }
  .lightbox::backdrop {
    background: var(--color-deep);
  }
  .lightbox-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 3.5rem 1rem 1.5rem;
  }
  .lightbox-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: min(1100px, 100%);
    max-height: 100%;
    margin: 0;
  }
  .lightbox-figure img {
    max-width: 100%;
    max-height: calc(100vh - 13rem);
    object-fit: contain;
    border: 1px solid var(--color-secondary);
  }
  .lightbox-figure figcaption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
    max-width: 40rem;
  }
  .lightbox-caption {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-on-deep);
    line-height: 1.4;
  }
  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    color: var(--color-secondary-light);
    font-size: 2.5rem;
    line-height: 1;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    background: transparent;
  }
  .lightbox-close:hover,
  .lightbox-nav:hover {
    color: var(--color-bg);
  }
  .lightbox-close { top: 0.5rem; right: 0.75rem; }
  .lightbox-prev { left: 0.25rem; top: 50%; transform: translateY(-50%); }
  .lightbox-next { right: 0.25rem; top: 50%; transform: translateY(-50%); }
  @media (max-width: 640px) {
    .lightbox-nav { top: auto; bottom: 0.5rem; transform: none; }
  }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const caption = document.getElementById('lightbox-caption');
  const enquire = document.getElementById('lightbox-enquire') as HTMLAnchorElement | null;
  // Step through photos in their listed order (data-index within each
  // gallery section), not the column-by-column order of the markup
  const items = [...document.querySelectorAll<HTMLButtonElement>('[data-lightbox-item]')].sort((a, b) => {
    const sectionA = a.closest('section');
    if (sectionA && sectionA === b.closest('section')) {
      return Number(a.dataset.index ?? 0) - Number(b.dataset.index ?? 0);
    }
    return a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1;
  });
  let current = 0;

  // Pick the widest candidate from the thumbnail's srcset
  function largestSrc(thumb: HTMLImageElement): string {
    const candidates = (thumb.srcset || '')
      .split(',')
      .map((c) => c.trim().split(/\s+/))
      .filter(([url]) => url)
      .map(([url, w]) => ({ url, w: parseInt(w ?? '0', 10) || 0 }))
      .sort((a, b) => b.w - a.w);
    return candidates[0]?.url ?? thumb.currentSrc ?? thumb.src;
  }

  function show(index: number) {
    if (!dialog || !img || !caption || !enquire || items.length === 0) return;
    current = (index + items.length) % items.length;
    const thumb = items[current].querySelector('img');
    if (!thumb) return;
    img.src = largestSrc(thumb);
    img.alt = thumb.alt;
    caption.textContent = items[current].dataset.title || thumb.alt;
    enquire.href = `/contact/?type=cake&design=${encodeURIComponent(thumb.alt)}`;
    if (!dialog.open) dialog.showModal();
  }

  items.forEach((item, i) => item.addEventListener('click', () => show(i)));
  dialog?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
  dialog?.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));

  // Click on the dark surround (not the photo or controls) closes
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog || (e.target as HTMLElement).classList.contains('lightbox-inner')) dialog.close();
  });

  dialog?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>
