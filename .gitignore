# Dependencies
node_modules/

# Build output
dist/
.next/
.astro/

# Environment
.env
.env.local
.env.*.local
.env.production
# Cloudflare local secrets (Airtable token, session secret, credentials)
.dev.vars

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Transient / staging — ignore contents but keep the folders so they
# survive `git clone` in projects that copy this template.
_inbox/*
!_inbox/.gitkeep
_cowork/*
!_cowork/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Local-only Claude Code settings (per-machine; commit settings.json instead)
.claude/settings.local.json
.claude/scheduled_tasks.lock
